# Riot API. Development keys expire every 24 hours: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_PLATFORM=na1
RIOT_REGION=americas

# Seeded crawl
SEED_RIOT_ID=bblskibs#gotg
CRAWL_QUEUE_ID=420
CRAWL_MIN_TIER=DIAMOND
CRAWL_MAX_TIER=MASTER
CRAWL_MATCHES_PER_PLAYER=100
CRAWL_MAX_MATCHES=1200
CRAWL_MAX_PLAYERS=90
CRAWL_MAX_DEPTH=2
CRAWL_TIMELINES=1
# Total Riot requests one crawl may spend; a development key allows 3000 per hour.
CRAWL_MAX_REQUESTS=2700
CRAWL_IDENTIFY_RESERVE=200
# Restrict a crawl to matches played in the last N days. 0 disables the window.
CRAWL_SINCE_DAYS=7
# Seeding from the apex ladders: minimum league points to enter the frontier.
CRAWL_APEX_MIN_LP=500
CRAWL_APEX_TIERS=challenger,grandmaster,master

# Corpus admission. Master 0 LP is 2800 on the lp_value scale.
# A match is dropped only when at least CORPUS_MIN_RANKED participants have a
# known rank and their average falls below the floor. 0 disables the filter.
CORPUS_MIN_AVERAGE_LP=2800
CORPUS_MIN_RANKED=2

# Riot rate limits. Defaults match a development key.
RIOT_RATE_SHORT_REQUESTS=20
RIOT_RATE_SHORT_SECONDS=1
RIOT_RATE_LONG_REQUESTS=100
RIOT_RATE_LONG_SECONDS=120
RIOT_MAX_RETRIES=4
RIOT_CONCURRENCY=8

# Storage and model
DATA_DIR=./data
DATABASE_URL=postgresql://synergy:synergy@localhost:5432/synergy
SYNERGY_SHRINKAGE_K=12
STYLE_SHRINKAGE_K=5
MIN_PROFILE_GAMES=3

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# REDIS_URL=redis://127.0.0.1:6379/1
